{
  "rules": {
    "typescript:S1848": {
      "level": "off",
      "parameters": {}
    },
    "javascript:S3776": {
      "parameters": {
        "threshold": 20
      }
    },
    "typescript:S3776": {
      "parameters": {
        "threshold": 20
      }
    },
    "typescript:S1479": {
      "parameters": {
        "maximum": 35
      }
    },
    "typescript:S6478": {
      "level": "off"
    },
    "typescript:S6582": {
      "level": "off"
    }
  },
  "typeScript": {
    "globals": [
      "describe",
      "it",
      "expect",
      "test",
      "beforeEach",
      "afterEach",
      "beforeAll",
      "afterAll",
      "vi",
      "vitest",
      "jest",
      "jasmine",
      "mocha",
      "chai",
      "global",
      "globalThis",
      "window",
      "document",
      "navigator",
      "console",
      "process",
      "Buffer",
      "__dirname",
      "__filename",
      "require",
      "module",
      "exports",
      "React",
      "JSX",
      "NodeJS"
    ]
  },
  "inclusions": "**/*.{js,jsx,ts,tsx}",
  "exclusions": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/coverage/**",
    "**/*.test.{js,jsx,ts,tsx}",
    "**/*.spec.{js,jsx,ts,tsx}",
    "**/storybook-static/**",
    "**/generated/**",
    "packages/database/generated/**",
    "packages/design-system/ui/**",
    "devapps/emailstudio/.react-email/**",
    "**/*.d.ts",
    "**/turbo/**",
    "**/.turbo/**"
  ],
  "test": {
    "inclusions": "**/*.test.{js,jsx,ts,tsx},**/*.spec.{js,jsx,ts,tsx}"
  }
}
